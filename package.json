{
  "name": "jumper-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JUMPER LAB: build a crab, steal a snack. A playable three.js robotics lab based on KingKong Robotics' Jumper.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --port 5176 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5177 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test tests/*.test.ts",
    "upstream:lock": "node tools/upstream.mjs lock",
    "upstream:fetch": "node tools/upstream.mjs fetch",
    "assets": "node tools/build-robot.mjs && node --experimental-strip-types --no-warnings=ExperimentalWarning tools/build-motions.mjs && npm run dance && npm run crowd",
    "dance": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/build-dance.mjs",
    "crowd": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/build-crowd.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "fast-xml-parser": "5.11.2",
    "meshoptimizer": "1.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
